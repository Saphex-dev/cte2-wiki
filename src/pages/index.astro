---
/* Landing page — a wiki portal, modelled on the Calamity Mod Wiki main page.

   Structure borrowed from Calamity: persistent left nav rail, a bordered
   welcome banner carrying live counts, a wide intro box beside a narrow
   version box, then a grid of titled portal panels holding multi-column
   index lists. Chrome is ours, not theirs — 16px grid, zero radius, bevelled
   edges, and the rarity palette extracted from the pack.

   Deliberately outside Starlight: Starlight owns the docs shell, this is the
   front door. Docs pages keep the Starlight layout.

   Every number, name and count below is read from data/ at build time.
   Nothing is hand-typed — see CLAUDE.md § Never invent pack data. */
import '../styles/tokens.css';
import Banner from '../components/Banner.astro';

import index from '../../data/_index.json';
import uniquesData from '../../data/uniques.json';
import statsData from '../../data/stats.json';
import baseGearData from '../../data/base_gear.json';
import professionsData from '../../data/professions.json';
import talentTreeData from '../../data/talent_trees.json';

type Roll = { type: string; min: number; max: number; stat: string };
type Unique = {
	id: string;
	group: string | null;
	name: string;
	data: {
		base_gear?: string;
		min_drop_lvl?: number;
		rarity?: string;
		league?: string;
		flavor_text?: string;
		unique_stats?: Roll[];
	};
};
type Named = { id: string; name: string };
type Tree = { identifier: string; school_type: string; nodes: unknown[] };

const uniques = uniquesData as Unique[];
const trees = talentTreeData as Tree[];
const statName = new Map((statsData as Named[]).map((s) => [s.id, s.name]));
const gearName = new Map((baseGearData as Named[]).map((g) => [g.id, g.name]));

const collections = new Map(index.collections.map((c) => [c.key, c]));
const count = (key: string) => collections.get(key)?.count ?? 0;

/* Talent trees carry a different envelope to every other collection — no id,
   no name, just an identifier and a node array — so they are counted by node
   rather than by entry, and left out of the entry total. */
const totalEntries = index.collections
	.filter((c) => c.key !== 'talent_trees')
	.reduce((sum, c) => sum + (c.count ?? 0), 0);
const totalNodes = trees.reduce((n, t) => n + t.nodes.length, 0);

/* Player classes come from how the pack files its spells: one folder per
   class, alongside a handful of folders that are plumbing rather than a
   class. Subfolders (`rogue/sub_spells`) fold into their parent.

   Note the pack disagrees with itself here: data/spell_schools.json lists
   `sorcerer` and `warrior` where the spell folders say `elementalist` and
   `fighter`. Both sources give twelve. The folders win here because they are
   what actually carries the spells; resolving which the player sees is a
   question for the extractor, not this template. */
const SUPPORT_GROUPS = new Set([
	'basic_summon_spells',
	'cast_sound_spells',
	'entity_cast_spells',
	'gear_spells',
	'identifier_spells',
]);
const spellGroups = collections.get('spells')?.groups ?? [];
const classes = spellGroups
	.filter((g) => !g.includes('/') && !SUPPORT_GROUPS.has(g))
	.map((g) => ({
		id: g,
		label: g.replace(/_/g, ' '),
		/* a class owns its folder plus any subfolder beneath it */
		n: spellGroups.filter((x) => x === g || x.startsWith(`${g}/`)).length,
	}));

/* ---- Items panel -------------------------------------------------------
   Uniques are filed by base gear type. Weapons and jewellery map one-to-one
   onto a base gear name; armour is six material families crossed with four
   slots, so it collapses to the family. `set_armor/<name>` is a matched set
   and counts as one entry rather than four. */
const ARMOUR_FAMILIES = [
	'cloth',
	'leather',
	'chainmail',
	'brigandine',
	'plate',
	'vest',
];
const JEWELLERY = new Set(['ring', 'necklace']);

const byGroup = new Map<string, number>();
for (const u of uniques) {
	const g = u.group ?? 'other';
	byGroup.set(g, (byGroup.get(g) ?? 0) + 1);
}

const armour = ARMOUR_FAMILIES.map((fam) => ({
	label: fam,
	n: [...byGroup].reduce(
		(sum, [g, n]) => (g.startsWith(`${fam}_`) ? sum + n : sum),
		0
	),
})).sort((a, b) => b.n - a.n);

const weapons = [...byGroup]
	.filter(
		([g]) =>
			!g.startsWith('set_armor/') &&
			!JEWELLERY.has(g) &&
			g !== 'other' &&
			!ARMOUR_FAMILIES.some((f) => g.startsWith(`${f}_`))
	)
	.map(([g, n]) => ({ label: gearName.get(g) ?? g.replace(/_/g, ' '), n }))
	.sort((a, b) => b.n - a.n || a.label.localeCompare(b.label));

const sets = [...byGroup]
	.filter(([g]) => g.startsWith('set_armor/'))
	.map(([g, n]) => ({ label: g.slice('set_armor/'.length).replace(/_/g, ' '), n }))
	.sort((a, b) => a.label.localeCompare(b.label));

const jewellery = [...byGroup]
	.filter(([g]) => JEWELLERY.has(g))
	.map(([g, n]) => ({ label: gearName.get(g) ?? g, n }))
	.sort((a, b) => b.n - a.n);

/* ---- Drop sources ------------------------------------------------------
   `league` on a unique is the pack's own answer to "where does this come
   from". Most uniques carry an empty league, meaning the ordinary drop pool;
   the rest name a specific endgame system. */
const LEAGUE_LABEL: Record<string, string> = {
	prophecy: 'Prophecy',
	obelisk: 'Ancient obelisks',
	uber: 'Uber bosses',
	strongbox: 'Strongboxes',
	harvest: 'The Harvest',
	imprisoned_monster: 'Imprisoned monsters',
	pinnacle: 'Pinnacle',
};
const leagueCounts = new Map<string, number>();
for (const u of uniques) {
	const l = u.data.league ?? '';
	if (!l) continue;
	leagueCounts.set(l, (leagueCounts.get(l) ?? 0) + 1);
}
const sources = [...leagueCounts]
	.map(([l, n]) => ({ label: LEAGUE_LABEL[l] ?? l.replace(/_/g, ' '), n }))
	.sort((a, b) => b.n - a.n);
const generalDrops = uniques.filter((u) => !u.data.league).length;

const professions = (professionsData as Named[]).map((p) => ({
	label: p.name,
	n: 0,
}));

const treeLabel: Record<string, string> = {
	talents: 'Talent tree',
	ascendancy: 'Ascendancy',
	atlas_passives: 'Atlas passives',
};
const treeEntries = trees
	.map((t) => ({ label: treeLabel[t.identifier] ?? t.identifier, n: t.nodes.length }))
	.sort((a, b) => b.n - a.n);

/* ---- Build discovery ---------------------------------------------------
   The pitch demonstrated rather than asserted: each playstyle is matched
   against the real stat ids rolled by real uniques. */
const PLAYSTYLES: { label: string; blurb: string; re: RegExp }[] = [
	{ label: 'Chaos', blurb: 'poison, decay, chaos conversion', re: /chaos|poison/ },
	{ label: 'Spell damage', blurb: 'casters and spell scaling', re: /spell/ },
	{ label: 'Critical', blurb: 'crit chance and multiplier', re: /crit/ },
	{ label: 'Cold', blurb: 'freeze, chill, water conversion', re: /cold|water|freeze|chill/ },
	{ label: 'Minions', blurb: 'summons and totems', re: /summon|minion|totem/ },
	{ label: 'Bleed', blurb: 'physical damage over time', re: /bleed/ },
];
const playstyles = PLAYSTYLES.map((p) => ({
	...p,
	n: uniques.filter((u) =>
		(u.data.unique_stats ?? []).some((s) => p.re.test(s.stat ?? ''))
	).length,
})).sort((a, b) => b.n - a.n);

/* Rarity ladder, straight from mmorpg_gear_rarity. The weights are the pack's
   own drop weights and form a clean 3x ladder. */
const RARITIES = [
	{ id: 'common', weight: 729 },
	{ id: 'uncommon', weight: 243 },
	{ id: 'rare', weight: 81 },
	{ id: 'epic', weight: 27 },
	{ id: 'legendary', weight: 9 },
	{ id: 'mythic', weight: 3 },
];

const FEATURED = ['starforge', 'voltaxic_rift', 'quill_rain'];
const featured = FEATURED.map((id) => uniques.find((u) => u.id === id)).filter(
	(u): u is Unique => Boolean(u)
);

/* Stat names carry inline tokens: [VAL1] placeholders and glyphs like the
   attribute star and damage-type sun. The value renders in its own column, so
   the placeholder is stripped rather than substituted — but a `%` written
   immediately after the placeholder belongs to the value, not the label. The
   roll's own type does not always carry it: Voltaxic Rift's proc chance is a
   FLAT roll whose name template is "[VAL1]% Chance to Cast ...". */
function renderRoll(r: Roll): { value: string; label: string } {
	const raw = statName.get(r.stat) ?? r.stat.replace(/_/g, ' ');
	const percentFromName = /\[VAL\d\]%/.test(raw);
	const percentFromType = r.type === 'PERCENT' || r.type === 'MORE';
	const suffix = percentFromName || percentFromType ? '%' : '';
	const sign = r.min < 0 ? '' : '+';
	const value =
		r.min === r.max
			? `${sign}${r.min}${suffix}`
			: `${sign}${r.min}–${r.max}${suffix}`;

	const label = raw
		.replace(/\[VAL\d\]%?/g, '')
		.replace(/[★☀]/g, '')
		.replace(/\s{2,}/g, ' ')
		.trim();

	return { value, label };
}

/* Everything the on-page filter can match, emitted once as JSON. Portal
   entries are matched in the DOM; unique names need the data, since 251 item
   rows would bloat the page for no reason until item routes exist. */
const searchIndex = uniques.map((u) => ({
	n: u.name,
	g: gearName.get(u.data.base_gear ?? '') ?? u.data.base_gear ?? '',
	l: u.data.min_drop_lvl ?? 0,
}));

/* Left rail, mirroring Calamity's grouped sidebar. `href` is set only where a
   route genuinely exists today; the rest are index entries, not dead links. */
const RAIL: { title: string; items: { label: string; href?: string }[] }[] = [
	{
		title: 'Wiki',
		items: [
			{ label: 'Main page', href: '/' },
			{ label: 'Documentation', href: '/guides/example/' },
			{ label: 'Contributing', href: 'https://github.com/Saphex-dev/cte2-wiki' },
		],
	},
	{
		title: 'Items',
		items: [
			{ label: 'Uniques' },
			{ label: 'Base gear' },
			{ label: 'Runewords' },
			{ label: 'Support gems' },
			{ label: 'Currency' },
		],
	},
	{
		title: 'Character',
		items: [
			{ label: 'Classes' },
			{ label: 'Skills' },
			{ label: 'Talents' },
			{ label: 'Ascendancy' },
			{ label: 'Perks' },
		],
	},
	{
		title: 'World',
		items: [
			{ label: 'Atlas' },
			{ label: 'Dungeons' },
			{ label: 'Prophecies' },
			{ label: 'Map affixes' },
			{ label: 'Professions' },
		],
	},
];

const title = 'Craft to Exile 2 Wiki';
const description =
	'A community wiki for Craft to Exile 2 — every unique, skill and passive, generated from the pack itself.';
---

<html lang="en" data-dimension="overworld">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="topbar">
			{/* The pack's logotype is the only mark on the page (D12). The wiki
			    names itself in text, the way the Calamity wiki does. */}
			<a class="wordmark" href="/">Craft to Exile 2 Wiki</a>

			<form class="search" role="search" onsubmit="return false">
				<label class="sr-only" for="q">Filter this page</label>
				<input
					id="q"
					type="search"
					autocomplete="off"
					placeholder="Filter this page…"
					aria-describedby="q-hint"
				/>
				<span id="q-hint" class="sr-only">
					Filters the index panels below and searches all {uniques.length} unique
					item names.
				</span>
			</form>

			<nav>
				<a href="/guides/example/">Docs</a>
				<a href="https://github.com/Saphex-dev/cte2-wiki">GitHub</a>
			</nav>
		</header>

		{/* Mahjerion's CTE2 banner — the page's only logo (D12).
		    Source is 560x300. Measuring the logo's pixels puts it in rows
		    114..181, so a centred crop can reach 7.78:1 before it starts
		    cutting letterforms. 7:1 leaves ~4px of margin either side. */}
		<div class="bannerwrap">
			<Banner src="/banner-cte2.webp" alt="Craft to Exile 2" ratio="7 / 1" />
		</div>

		<div class="shell">
			<aside class="rail" aria-label="Wiki navigation">
				{
					RAIL.map((group) => (
						<section class="railgroup bevel">
							<h2>{group.title}</h2>
							<ul>
								{group.items.map((it) => (
									<li>
										{it.href ? (
											<a href={it.href}>{it.label}</a>
										) : (
											<span class="pending">{it.label}</span>
										)}
									</li>
								))}
							</ul>
						</section>
					))
				}
			</aside>

			<main>
				<section class="welcome">
					<h1>
						Welcome to the <strong>Craft to Exile 2 Wiki</strong>,
					</h1>
					<p class="tagline">
						the community reference, generated from the modpack itself.
					</p>
					<p class="counts">
						<strong>{totalEntries.toLocaleString('en-US')}</strong> entries across
						{' '}<strong>{index.collections.length - 1}</strong> collections, read
						from Craft to Exile 2 <strong>{index.pack_version}</strong>.
					</p>
					<hr />
					{/* Chrome, not data: these are entry counts, and a count has no
					    rarity. Tinting them across the rarity ladder taught a meaning
					    that was not there — see ROADMAP § D9. */}
					<p class="tally">
						<span style="--tint:var(--accent)">
							{count('uniques')} uniques
						</span>
						<span style="--tint:var(--accent)">{count('spells')} skills</span>
						<span style="--tint:var(--accent)">
							{classes.length} classes
						</span>
						<span style="--tint:var(--accent)">
							{totalNodes.toLocaleString('en-US')} passive nodes
						</span>
						<span style="--tint:var(--accent)">
							{count('atlas_nodes')} atlas nodes
						</span>
					</p>
					<p class="links">
						<a href="https://github.com/Saphex-dev/cte2-wiki">GitHub</a> &bull;
						<a href="https://github.com/Saphex-dev/cte2-wiki/issues">
							Report an error
						</a> &bull;
						<a href="/guides/example/">Documentation</a>
					</p>
				</section>

				<div class="row">
					<section class="panel">
						<h2 class="ptitle">The Pack</h2>
						<div class="pbody prose">
							<p>
								<strong>Craft to Exile 2</strong> is a Minecraft {index.minecraft}
								{' '}Forge modpack by Mahjerion, built on Mine and Slash — an ARPG
								overhaul in the Path of Exile mould. It bundles {index.mod_count}
								{' '}mods into a single campaign with its own classes, passive
								trees, crafting economy and map endgame.
							</p>
							<p>
								This wiki is not written by hand. Every stat line, roll range and
								count on the site is extracted straight out of the pack's own
								registry files, so a pack update regenerates the wiki rather than
								obsoleting it.
							</p>
							<p class="note">
								Unofficial and community-run. Corrections and additions arrive as
								pull requests — see <a href="/guides/example/">Documentation</a>.
							</p>
						</div>
					</section>

					<section class="panel narrow">
						<h2 class="ptitle">Pack Version</h2>
						<dl class="versions">
							<div><dt>Craft to Exile 2</dt><dd>{index.pack_version}</dd></div>
							<div><dt>Minecraft</dt><dd>{index.minecraft}</dd></div>
							<div><dt>Loader</dt><dd>Forge</dd></div>
							<div><dt>Mods</dt><dd>{index.mod_count}</dd></div>
							<div>
								<dt>Extracted entries</dt>
								<dd>{totalEntries.toLocaleString('en-US')}</dd>
							</div>
							<div>
								<dt>Collections</dt>
								<dd>{index.collections.length - 1}</dd>
							</div>
						</dl>
					</section>
				</div>

				<div class="portals">
					<section class="panel portal" data-panel>
						<h2 class="ptitle">Items</h2>
						<div class="pbody">
							<div class="cols">
								<div class="col">
									<h3>Weapons and offhand</h3>
									<ul>
										{
											weapons.map((w) => (
												<li data-entry data-label={w.label}>
													<span class="e">{w.label}</span>
													<span class="c">{w.n}</span>
												</li>
											))
										}
									</ul>
								</div>
								<div class="col">
									<h3>Armour</h3>
									<ul>
										{
											armour.map((a) => (
												<li data-entry data-label={a.label}>
													<span class="e">{a.label}</span>
													<span class="c">{a.n}</span>
												</li>
											))
										}
									</ul>
									<h3>Jewellery</h3>
									<ul>
										{
											jewellery.map((j) => (
												<li data-entry data-label={j.label}>
													<span class="e">{j.label}</span>
													<span class="c">{j.n}</span>
												</li>
											))
										}
									</ul>
								</div>
								<div class="col">
									<h3>Armour sets</h3>
									<ul>
										{
											sets.map((s) => (
												<li data-entry data-label={s.label}>
													<span class="e">{s.label}</span>
													<span class="c">{s.n}</span>
												</li>
											))
										}
									</ul>
								</div>
							</div>
							<ul class="alsorow">
								<li data-entry data-label="base gear">
									<span class="e">Base gear</span><span class="c">
										{count('base_gear')}
									</span>
								</li>
								<li data-entry data-label="runewords">
									<span class="e">Runewords</span><span class="c">
										{count('runewords')}
									</span>
								</li>
								<li data-entry data-label="support gems">
									<span class="e">Support gems</span><span class="c">
										{count('support_gems')}
									</span>
								</li>
								<li data-entry data-label="currency">
									<span class="e">Currency</span><span class="c">
										{count('currency')}
									</span>
								</li>
								<li data-entry data-label="item modifications">
									<span class="e">Item modifications</span><span class="c">
										{count('item_modifications')}
									</span>
								</li>
								<li data-entry data-label="affixes">
									<span class="e">Affixes</span><span class="c">
										{count('affixes')}
									</span>
								</li>
							</ul>
						</div>
					</section>

					<section class="panel portal" data-panel>
						<h2 class="ptitle">Classes and Skills</h2>
						<div class="pbody">
							<div class="cols three">
								{
									classes.map((c) => (
										<div class="classcell" data-entry data-label={c.label}>
											<span class="e">{c.label}</span>
										</div>
									))
								}
							</div>
							<ul class="alsorow">
								<li data-entry data-label="skills spells">
									<span class="e">All skills</span><span class="c">
										{count('spells')}
									</span>
								</li>
								<li data-entry data-label="auras">
									<span class="e">Auras</span><span class="c">
										{count('auras')}
									</span>
								</li>
								<li data-entry data-label="exile effects">
									<span class="e">Exile effects</span><span class="c">
										{count('exile_effects')}
									</span>
								</li>
								<li data-entry data-label="gems">
									<span class="e">Gems</span><span class="c">{count('gems')}</span>
								</li>
								<li data-entry data-label="stats">
									<span class="e">Stats</span><span class="c">
										{count('stats')}
									</span>
								</li>
							</ul>
						</div>
					</section>

					<section class="panel portal" data-panel>
						<h2 class="ptitle">Passives</h2>
						<div class="pbody">
							<ul class="wide">
								{
									treeEntries.map((t) => (
										<li data-entry data-label={t.label}>
											<span class="e">{t.label}</span>
											<span class="c">{t.n.toLocaleString('en-US')}</span>
										</li>
									))
								}
								<li data-entry data-label="perks">
									<span class="e">Perks</span>
									<span class="c">{count('perks').toLocaleString('en-US')}</span>
								</li>
								<li data-entry data-label="runes">
									<span class="e">Runes</span><span class="c">
										{count('runes')}
									</span>
								</li>
							</ul>
						</div>
					</section>

					<section class="panel portal" data-panel>
						<h2 class="ptitle">World and Endgame</h2>
						<div class="pbody">
							<div class="cols">
								<ul>
									<li data-entry data-label="atlas nodes">
										<span class="e">Atlas nodes</span><span class="c">
											{count('atlas_nodes')}
										</span>
									</li>
									<li data-entry data-label="map affixes">
										<span class="e">Map affixes</span><span class="c">
											{count('map_affixes')}
										</span>
									</li>
									<li data-entry data-label="dungeons">
										<span class="e">Dungeons</span><span class="c">
											{count('dungeons')}
										</span>
									</li>
									<li data-entry data-label="prophecies">
										<span class="e">Prophecies</span><span class="c">
											{count('prophecies')}
										</span>
									</li>
								</ul>
								<ul>
									<li data-entry data-label="omens">
										<span class="e">Omens</span><span class="c">
											{count('omens')}
										</span>
									</li>
									<li data-entry data-label="shrine buffs">
