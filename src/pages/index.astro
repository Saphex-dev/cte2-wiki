		<script is:inline define:vars={{ searchIndex }}>
			/* On-page filter. It narrows the index panels and searches every unique
			   name, which is the useful search until item routes exist — Pagefind
			   only indexes the Starlight docs pages, so wiring the header to it
			   today would return two example pages and nothing else. */
			(function () {
				const q = document.getElementById('q');
				if (!q) return;
				const entries = Array.from(document.querySelectorAll('[data-entry]'));
				const panels = Array.from(document.querySelectorAll('[data-panel]'));
				const statics = Array.from(document.querySelectorAll('[data-static]'));
				const results = document.getElementById('results');
				const hits = document.getElementById('hits');
				const more = document.getElementById('hitsmore');
				const LIMIT = 30;

				function reset() {
					for (const el of entries) el.hidden = false;
					for (const el of panels) el.hidden = false;
					for (const el of statics) el.hidden = false;
					results.hidden = true;
					hits.textContent = '';
					more.textContent = '';
				}

				function apply(term) {
					if (!term) return reset();

					for (const el of entries) {
						const label = (el.getAttribute('data-label') || '').toLowerCase();
						el.hidden = !label.includes(term);
					}
					for (const p of panels) {
						const shown = p.querySelectorAll('[data-entry]:not([hidden])');
						p.hidden = shown.length === 0;
					}
					for (const el of statics) el.hidden = true;

					const matched = searchIndex.filter((u) =>
						u.n.toLowerCase().includes(term)
					);
					hits.textContent = '';
					for (const u of matched.slice(0, LIMIT)) {
						const li = document.createElement('li');
						const name = document.createElement('span');
						name.className = 'hitname';
						name.textContent = u.n;
						const meta = document.createElement('span');
						meta.className = 'hitmeta';
						meta.textContent = u.g ? u.g + ' · lvl ' + u.l : 'lvl ' + u.l;
						li.append(name, meta);
						hits.append(li);
					}
					more.textContent = matched.length
						? matched.length > LIMIT
							? matched.length + ' uniques match — showing the first ' + LIMIT + '.'
							: matched.length + (matched.length === 1 ? ' unique matches.' : ' uniques match.')
						: 'No unique item name matches that.';
					results.hidden = false;
				}

				q.addEventListener('input', () => apply(q.value.trim().toLowerCase()));
				q.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						q.value = '';
						reset();
					}
				});
			})();
		</script>

