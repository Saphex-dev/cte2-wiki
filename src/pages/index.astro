				display: flex;
				flex-wrap: wrap;
				gap: var(--s1);
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.ladder li {
				display: flex;
				align-items: center;
				gap: 8px;
				background: var(--bg-deep);
				padding: 8px var(--s1);
				border: 1px solid var(--line);
			}
			.swatch {
				width: 16px;
				height: 16px;
				display: block;
			}
			.rname {
				font-size: 14px;
				text-transform: capitalize;
			}
			.rweight {
				font-family: var(--font-mono);
				font-size: 12px;
				color: var(--ink-faint);
			}

			/* ---- footer ---- */
			footer {
				border-top: 1px solid var(--line);
				padding: var(--s4) var(--s2);
				text-align: center;
				color: var(--ink-faint);
				font-size: 14px;
			}
			footer p {
				margin: 0 0 8px;
			}
			.fine {
				font-family: var(--font-mono);
				font-size: 12px;
			}

			@media (max-width: 1024px) {
				.shell {
					grid-template-columns: minmax(0, 1fr);
				}
				.rail {
					position: static;
					display: grid;
					grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
				}
				.row {
					grid-template-columns: minmax(0, 1fr);
				}
			}
			@media (max-width: 640px) {
				.topbar {
					flex-wrap: wrap;
					gap: var(--s1);
				}
				.search {
					order: 3;
					flex: 1 1 100%;
					margin-left: 0;
				}
				.shell {
					padding: var(--s1);
				}
				.bannerwrap {
					padding: var(--s1) var(--s1) 0;
				}
				.portals {
					grid-template-columns: minmax(0, 1fr);
				}
				.pbody {
					padding: var(--s1);
				}
			}
		</style>
	</body>
