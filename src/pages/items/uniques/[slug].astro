---
/* The unique item page. Infobox-anchored, per docs/DESIGN.md § 3 and ROADMAP D15.
 *
 * Prose leads the main column; every structured field lives in the box on the
 * right. This inverts the earlier layout, where the in-game tooltip was the
 * hero (D5) — that decision is superseded, though its reasoning is why the box
 * exists at all: there is no per-unique art (ROADMAP § 1.5), so the frame and
 * the type have to carry identity.
 *
 * Nothing in the prose below is written about a specific item. Every sentence is
 * assembled from a field that resolved against a pack registry, and a field that
 * is absent produces no sentence rather than a hedge. That is the only way this
 * survives 251 pages.
 */
import Site from '../../../layouts/Site.astro';
import ActLadder from '../../../components/ActLadder.astro';
import Infobox, { type InfoSection } from '../../../components/Infobox.astro';
import { all, siblings, uniquePhrase, type Unique } from '../../../lib/uniques';
import { bandTitles, joinTitles, stripArticle } from '../../../lib/dimensions';
import { backdropFor } from '../../../lib/backdrop';

export function getStaticPaths() {
	/* Every unique gets a page. This was a five-item sample while the template
	   was being proved out — the four that stress it (a 126-character stat name,
	   the most rolls in the set, a mechanic tie, a granted spell) plus a
	   baseline. They all render, so the filter is gone.

	   All 251 is not a scale decision to agonise over: they are static pages off
	   data that is already in memory, and the whole build is still seconds. The
	   real reason to generate them is that a browse page listing 251 uniques
	   where 246 are dead links is worse than no browse page at all. */
	return all.map((u) => ({ params: { slug: u.slug }, props: { item: u } }));
}

interface Props {
	item: Unique;
}
const { item } = Astro.props;
const related = siblings(item);
const base = item.baseType.toLowerCase();
const bands = bandTitles(item.bands);

/* Bands overlap and the pack records no drop location, so there is no true
   single dimension for an item. The backdrop takes the deepest band the
   level reaches — a display choice, and nothing on the page presents it as a
   fact: the ladder below lights every band, and the prose names them all. */
const backdrop = backdropFor(item.dropLevel);

const description = `${item.name} — ${uniquePhrase(item.baseType)} in Craft to Exile 2, with its full stat rolls.`;

/* Counted, not asserted. Granting a spell is genuinely unusual and the lede
   says so — but it only gets to say so with the real number behind it. */
const grantCount = all.filter((u) => u.grants.length > 0).length;

/* ---- Infobox ------------------------------------------------------------
   Rows are pushed only when the field resolved. An item that yields four rows
   renders four rows; that is correct output, not a gap to paper over. */
const stats: InfoSection = { title: 'Statistics', rows: [] };

if (item.family) stats.rows!.push({ label: 'Family', value: item.family });
stats.rows!.push({ label: 'Base', value: item.baseType });
if (item.slot) stats.rows!.push({ label: 'Slot', value: item.slot });
stats.rows!.push({
	label: 'Rarity',
	value: item.rarity.replace(/\b\w/g, (c) => c.toUpperCase()),
	colour: `var(--r-${item.rarity})`,
});
/* `min_drop_lvl` is a PLAYER LEVEL THRESHOLD and nothing else. The mod's own
   lang calls it "Min Drop Level" and phrases it "Drops at Levels: %s", and a
   unique carries no max level, no dimension and no biome field — the only
   twelve fields on the record are base_gear, guid, flavor_text, force_item_id,
   league, min_drop_lvl, min_tier, rarity, replaces_name, runable, unique_stats
   and weight.

   So the row says "from level N onward" and carries NO dimension. An earlier
   version appended the band name here, which read as a drop location. It was
   wrong and it was the most-read line on the page. */
stats.rows!.push({
	label: 'Drops from',
	value: `level ${item.dropLevel}`,
	qualifier: 'onward',
});
if (item.mapTier > 0) {
	stats.rows!.push({ label: 'Map tier', value: `${item.mapTier}+` });
}
if (item.baseDamage) {
	stats.rows!.push({
		label: 'Base damage',
		value: item.baseDamage,
		qualifier: 'before rolls',
	});
}
if (item.scaling) {
	stats.rows!.push({
		label: 'Scales on',
		value: item.scaling.attribute,
		qualifier: `${item.scaling.factor}×`,
	});
}
if (item.mechanic) stats.rows!.push({ label: 'Found via', value: item.mechanic });

const sections: InfoSection[] = [
	stats,
	{
		title: item.rolls.length === 1 ? 'Stat roll' : 'Stat rolls',
		blocks: item.rolls.map((r) => ({ value: r.value, label: r.label, colour: r.colour })),
	},
	/* `learn_<spell>` is not a stat. All 15 unresolvable roll entries across the
	   251 uniques are `learn_*`, and all 14 distinct suffixes resolve against
	   spells.json — so they get their own section rather than rendering as a
	   stat line with a missing label. No href: there are no spell pages yet, and
	   nav.ts's rule is that a link exists only when its route does. */
	{
		title: item.grants.length === 1 ? 'Grants skill' : 'Grants skills',
		links: item.grants.map((g) => ({ label: g.name })),
	},
	/* The build vocabulary, and the reason this site is more than a lookup. It
	   lives in the box rather than the prose so it is one more scannable row
	   among the others, and so Pagefind indexes it with everything else. */
	{ title: 'Build tags', links: item.tags.map((t) => ({ label: t })) },
];

/* There is deliberately no auto-generated Notes section. Every bullet it could
   hold from pack data — map tier, mechanic, base damage, scaling — is already
   a row in the box, and a Notes list that restates the box is padding.
   Notes is where HAND-WRITTEN detail lands, which is exactly the thing
   analytics is in place to identify (CLAUDE.md § Contributions). Until an item
   earns that, the main column carries the lede, the run placement and the
   sibling list, and says nothing it cannot source. */
---

<Site
	title={item.name}
	description={description}
	{/* Tags join the filter set: build discovery is the point of tagging them,
	    and a tag nobody can filter on does no work. */}
	filters={{
		section: 'Items',
		kind: 'Unique',
		base: item.baseType,
		...(item.tags.length > 0 ? { build: item.tags } : {}),
	}}
	crumbs={[
		{ label: 'Wiki', href: '/' },
		{ label: 'Items', href: '/items/' },
	]}
	dimension={backdrop?.slug ?? null}
>
	<div class="itemlayout">
		<div class="prose">
			<h1 class="itemname">{item.name}</h1>

			{/* Family is left to the box — "greatsword" already tells a reader it is
			    a weapon, and a lede that says so twice reads as generated. */}
			<p class="lede">
				<strong>{item.name}</strong> is {uniquePhrase(item.baseType)}. It starts dropping at
				character level {item.dropLevel} and it rolls {item.rolls.length}
				{item.rolls.length === 1 ? ' stat line' : ' stat lines'}.
				{
					item.grants.length > 0 && (
						<>
							{' '}
							It also teaches {joinTitles(item.grants.map((g) => g.name))} while equipped —
							only {grantCount} of the {all.length} uniques do.
						</>
					)
				}
			</p>

			<h2>When it starts dropping</h2>
			<p>
				{item.name} can drop once your character reaches <strong>level {item.dropLevel}</strong>,
				and it keeps dropping at every level above that. The pack sets no upper limit and
				ties the item to no dimension — your level is the only condition
				{item.mapTier > 0 ? `, beyond needing a tier ${item.mapTier} map or higher` : ''}.
			</p>
			<p class="caveat">
				The ladder below is the pack's dimension level ranges, shown only to place level
				{' '}{item.dropLevel} in the run. {
					bands.length > 1
						? `That level is around where the run reaches ${joinTitles(bands)}.`
						: bands.length === 1
							? `That level is around where the run reaches the ${stripArticle(bands[0])}.`
							: `No dimension band covers level ${item.dropLevel} — the pack's ladder has a real gap at 76–89.`
				} <strong>It is not where the item drops.</strong>
			</p>
			<ActLadder highlight={item.bands} />

			{
				related.length > 0 && (
					<>
						<h2>Other {base} uniques</h2>
						<ul class="related">
							{related.map((r) => (
								<li>
									<span>{r.name}</span>
									<span class="c">from {r.dropLevel}</span>
								</li>
							))}
						</ul>
					</>
				)
			}
		</div>

		<Infobox
			title={item.name}
			accent={`var(--r-${item.rarity})`}
			spriteLabel={item.baseType}
			sections={sections}
			flavour={item.flavour}
		/>
	</div>
</Site>

<style>
	.itemlayout {
		display: flex;
		align-items: flex-start;
		gap: var(--s2);
	}
	.prose {
		flex: 1 1 auto;
		min-width: 0;
		max-width: var(--w-prose);
	}

	/* One of the two reserved uses of the pixel face (D11), and the reason an
	   item still reads as special without any art. 24px because the face is
	   drawn on an 8px grid and is only crisp at multiples of 8. */
	/* Sized against the LONGEST name in the set, not a typical one: the pixel
	   face advances a full em per glyph (D11), so "Zazzith, Curse of the
	   Restless Dead" is 35 glyphs = 840px at 24px, against an 848px column. It
	   fits, but only just, so the size steps down with the column rather than
	   wrapping a heading into three lines. 24 and 16 because the face is drawn
	   on an 8px grid and is only crisp at multiples of 8. */
	.itemname {
		font-family: var(--font-pixel);
		font-size: 24px;
		font-weight: 400;
		letter-spacing: normal;
		line-height: 1.4;
		color: var(--r-unique);
		margin-bottom: var(--s1);
	}

	.lede {
		font-size: var(--t-body);
		color: var(--ink-dim);
		margin: 0 0 var(--s2);
	}
	.lede strong {
		color: var(--ink);
	}

	.caveat {
		font-size: var(--t-small);
		color: var(--ink-fainter);
		margin: 0 0 var(--s1);
		max-width: 72ch;
	}

	.related {
		list-style: none;
		margin: 0;
		padding: 0;
		columns: 2;
		column-gap: var(--s2);
	}
	.related li {
		display: flex;
		justify-content: space-between;
		gap: var(--s1);
		font-size: var(--t-data);
		padding: var(--m2) 0;
		border-bottom: 1px solid var(--line);
		break-inside: avoid;
	}
	.related .c {
		font-family: var(--font-mono);
		font-size: var(--t-small);
		color: var(--ink-fainter);
		white-space: nowrap;
	}

	@media (max-width: 1200px) {
		.itemname {
			font-size: 16px;
		}
	}
	@media (max-width: 900px) {
		.itemlayout {
			flex-direction: column;
		}
		.related {
			columns: 1;
		}
	}
</style>
