---
import Site from '../../layouts/Site.astro';
import { count } from '../../data/collections';
import uniquesData from '../../../data/uniques.json';

type Unique = { id: string; group: string | null; name: string };
const uniques = uniquesData as Unique[];

/* Base types, by how many uniques sit on them. Armour sets are filed under
   set_armor/<name> and are a different thing, so they are counted apart. */
const sets = new Set(
	uniques
		.map((u) => u.group)
		.filter((g): g is string => Boolean(g?.startsWith('set_armor/')))
		.map((g) => g.split('/')[1])
);

const byBase = new Map<string, number>();
for (const u of uniques) {
	if (!u.group || u.group.startsWith('set_armor/')) continue;
	byBase.set(u.group, (byBase.get(u.group) ?? 0) + 1);
}
const bases = [...byBase.entries()]
	.map(([id, n]) => ({ label: id.replace(/_/g, ' '), n }))
	.sort((a, b) => b.n - a.n || a.label.localeCompare(b.label));

const AREAS = [
	{ label: 'Uniques', n: count('uniques'), blurb: 'Named gear with fixed stat lines and their own roll ranges.' },
	{ label: 'Base gear', n: count('base_gear'), blurb: 'The item types everything else is built on, each with its own stat ranges.' },
	{ label: 'Affixes', n: count('affixes'), blurb: 'The prefixes, suffixes and implicits that roll onto gear.' },
	{ label: 'Runewords', n: count('runewords'), blurb: 'Rune sequences that grant fixed stats in the right slot.' },
	{ label: 'Runes', n: count('runes'), blurb: 'The individual runes runewords are spelled with.' },
	{ label: 'Gems', n: count('gems'), blurb: 'Socketed stones that give different stats in armour, jewellery and weapons.' },
	{ label: 'Support gems', n: count('support_gems'), blurb: 'Modifiers that change how a linked skill behaves.' },
	{ label: 'Armour sets', n: sets.size, blurb: 'Matched pieces that reward wearing several at once.' },
];

const title = 'Items';
const description =
	'Uniques, base gear, affixes, runewords, gems and sets in Craft to Exile 2.';
---

<Site
	title={title}
	description={description}
	filters={{ section: 'Items' }}
	crumbs={[{ label: 'Wiki', href: '/' }]}
>
	<div class="pagehead">
		<h1>Items</h1>
		<p>
			Every stat line and roll range below is read out of the pack itself. There are
			{' '}{count('uniques')} unique items across {bases.length} base types, plus {sets.size}
			{' '}armour sets.
		</p>
	</div>

	<div class="sectiongrid" style="margin-bottom: var(--s2)">
		{
			AREAS.map((a) => (
				<div class="sectioncard bevel">
					<h3>{a.label}</h3>
					<p>{a.blurb}</p>
					<span class="n">{a.n.toLocaleString('en-US')}</span>
				</div>
			))
		}
	</div>

	<section class="panel bevel">
		<h2 class="ptitle">Uniques by base type</h2>
		<div class="pbody">
			<p class="phint">
				Which weapon and armour types carry the most named gear. One base type is
				worked through end to end as a sample:
				{' '}<a href="/items/uniques/starforge/">Starforge</a>.
			</p>
			<div class="cols">
				<ul>
					{
						bases.slice(0, Math.ceil(bases.length / 3)).map((b) => (
							<li>
								<span>{b.label}</span>
								<span class="c">{b.n}</span>
							</li>
						))
					}
				</ul>
				<ul>
					{
						bases
							.slice(Math.ceil(bases.length / 3), Math.ceil((bases.length * 2) / 3))
							.map((b) => (
								<li>
									<span>{b.label}</span>
									<span class="c">{b.n}</span>
								</li>
							))
					}
				</ul>
				<ul>
					{
						bases.slice(Math.ceil((bases.length * 2) / 3)).map((b) => (
							<li>
								<span>{b.label}</span>
								<span class="c">{b.n}</span>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>
</Site>
