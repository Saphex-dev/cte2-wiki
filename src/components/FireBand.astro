---
/* Minecraft-style fire along the bottom of the viewport.
 *
 * The palette is not chosen. It is the modal colour of each luminance band of
 * vanilla `assets/minecraft/textures/block/fire_0.png` (16x512, the 32-frame
 * animation strip) read out of the 1.20.1 client jar:
 *
 *   #b64800  #bb5100  #d28108  #dfa21a  #eecc54  #ffffff
 *
 * As the reader scrolls, that ramp cross-fades to a violet one built from the
 * brand palette — the colours sampled from Mahjerion's icon. Deliberately NOT
 * `--mc-dark-purple`: that hex is the mythic rarity, and a rarity colour used
 * as decoration is the thing D13 still forbids.
 *
 * Rendering is the classic cellular fire automaton on a canvas sized in whole
 * 8px cells, then upscaled with `image-rendering: pixelated`. A CSS gradient
 * would be smooth and wrong; this is actually blocky, and it costs a few
 * thousand cell updates a frame.
 *
 * It stops when it should: `prefers-reduced-motion` gets one static frame and
 * no animation loop at all, and the loop also halts when the tab is hidden or
 * the band scrolls out of view.
 */
interface Props {
	/** Band height as a fraction of the viewport. */
	height?: string;
	/** Logical pixel size of one fire cell. */
	cell?: number;
}
const { height = '12.5vh', cell = 8 } = Astro.props;
---

<div class="fireband" style={`--fb-h:${height}`} aria-hidden="true">
	<canvas id="fireband" data-cell={cell}></canvas>
</div>

<style>
	.fireband {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: var(--fb-h);
		/* Behind every card, in front of the page ground. */
		z-index: 0;
		pointer-events: none;
		/* Atmosphere, not foreground. At full strength the white-hot cells
		   pull the eye off the content they sit behind. */
		opacity: 0.55;
		/* The flames should emerge from the ground rather than sit on a hard
		   edge, so the band fades out at its top. */
		-webkit-mask-image: linear-gradient(to top, #000 55%, transparent 100%);
		mask-image: linear-gradient(to top, #000 55%, transparent 100%);
	}
	.fireband canvas {
		display: block;
		width: 100%;
		height: 100%;
		image-rendering: pixelated;
	}
</style>

<script>
	const FIRE = ['#b64800', '#bb5100', '#d28108', '#dfa21a', '#eecc54', '#ffffff'];
	const VOID = ['#2a1040', '#472281', '#6a35b5', '#844dec', '#c57eff', '#ffffff'];

	const hex = (h: string): [number, number, number] => [
		parseInt(h.slice(1, 3), 16),
		parseInt(h.slice(3, 5), 16),
		parseInt(h.slice(5, 7), 16),
	];
	const FIRE_RGB = FIRE.map(hex);
	const VOID_RGB = VOID.map(hex);

	const canvas = document.getElementById('fireband') as HTMLCanvasElement | null;
	if (canvas) {
		const ctx = canvas.getContext('2d', { alpha: true })!;
		const CELL = Number(canvas.dataset.cell) || 8;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		let cols = 0,
			rows = 0,
			heat: Uint8Array = new Uint8Array(0),
			depth = 0,
			visible = true,
			raf = 0;

		/* Palette is rebuilt per frame from the scroll position: index 0 is
		   "no fire" and stays transparent, so the band never becomes a
		   rectangle of colour. */
		function paletteAt(t: number) {
			const stops = FIRE_RGB.map((f, i) => {
				const v = VOID_RGB[i];
				return `rgb(${Math.round(f[0] + t * (v[0] - f[0]))},${Math.round(
					f[1] + t * (v[1] - f[1])
				)},${Math.round(f[2] + t * (v[2] - f[2]))})`;
			});
			return stops;
		}

		function resize() {
			const r = canvas.getBoundingClientRect();
			cols = Math.max(8, Math.ceil(r.width / CELL));
			rows = Math.max(4, Math.ceil(r.height / CELL));
			canvas.width = cols;
			canvas.height = rows;
			heat = new Uint8Array(cols * rows);
			for (let x = 0; x < cols; x++) heat[(rows - 1) * cols + x] = FIRE.length;
		}

		function spread() {
			for (let y = 0; y < rows - 1; y++) {
				for (let x = 0; x < cols; x++) {
					const from = (y + 1) * cols + x;
					const decay = (Math.random() * 3) | 0;
					const to = from - cols - decay + 1;
					if (to < 0 || to >= heat.length) continue;
					const v = heat[from] - (decay & 1);
					heat[to] = v > 0 ? v : 0;
				}
			}
		}

		function paint() {
			const max = Math.max(1, document.body.scrollHeight - innerHeight);
			depth = Math.min(1, Math.max(0, scrollY / max));
			const pal = paletteAt(depth);
			ctx.clearRect(0, 0, cols, rows);
			for (let y = 0; y < rows; y++) {
				for (let x = 0; x < cols; x++) {
					const v = heat[y * cols + x];
					if (v <= 0) continue;
					ctx.fillStyle = pal[Math.min(pal.length - 1, v - 1)];
					ctx.fillRect(x, y, 1, 1);
				}
			}
		}

		function frame() {
			if (!visible || document.hidden) {
				raf = 0;
				return;
			}
			spread();
			paint();
			raf = requestAnimationFrame(frame);
		}
		function start() {
			if (!raf && !reduced) raf = requestAnimationFrame(frame);
		}

		resize();
		if (reduced) {
			/* Settle the automaton once and draw a single frame. */
			for (let i = 0; i < 60; i++) spread();
			paint();
		} else {
			start();
		}

		addEventListener('resize', () => {
			resize();
			if (reduced) {
				for (let i = 0; i < 60; i++) spread();
				paint();
			}
		});
		addEventListener('scroll', () => {
			if (reduced) paint();
		}, { passive: true });
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) start();
		});
		new IntersectionObserver(
			(es) => {
				visible = es[0].isIntersecting;
				if (visible) start();
			},
			{ threshold: 0 }
		).observe(canvas);
	}
</script>
